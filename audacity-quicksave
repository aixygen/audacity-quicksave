USAGE = f"""\
{APP} {VERSION}
Save the audio open in Audacity back over the original file.

usage: {APP}            save the active Audacity project over its original file
       {APP} --version
"""


def run_save(cfg):
    """Connect, save, and always disconnect.

    The connection must not stay open: while a script holds the pipe,
    Audacity cannot quit cleanly. When the client disconnects, Audacity
    recreates the pipes and waits for the next one.
    """
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(RUNTIME_DIR / f"{APP}.lock", "w") as lock:
        try:
            # Two quick presses must not talk to Audacity at the same time.
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return None
        pipe = AudacityPipe()
        try:
            return save(pipe, cfg)
        finally:
            pipe.close()


def main(argv):
    arg = argv[1] if len(argv) > 1 else ""
    if arg in ("-h", "--help"):
        print(USAGE)
        return 0
    if arg == "--version":
        print(f"{APP} {VERSION}")
        return 0
    if arg in ("--stop", "--status"):
        # Kept for compatibility with 1.0 development builds, nothing to do.
        return 0
    if arg:
        print(USAGE, file=sys.stderr)
        return 2

    cfg = load_config()
    use_notify = cfg.getboolean("notifications", fallback=True)
    try:
        result = run_save(cfg)
    except QuickSaveError as exc:
        log(f"error: {exc}")
        if use_notify:
            notify(msg("error_title"), str(exc), error=True)
        else:
            print(exc, file=sys.stderr)
        return 1
    except Exception as exc:
        log(f"unexpected error: {exc!r}")
        notify(msg("error_title"), repr(exc), error=True)
        return 1
    if result is None:
        return 0  # another save is already running
    # GNOME joins lines in notifications, so keep it on one line.
    body = f"{msg('saved', name=Path(result['file']).name)}, {result['details']}"
    if use_notify:
        notify(msg("ok_title"), body)
    else:
        print(body)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
